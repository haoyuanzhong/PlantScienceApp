<resources>
    <!-- 统一使用 MaterialComponents -->
    <style name="Theme.PlantScienceapp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/accent_indoor</item>
        <item name="colorPrimaryVariant">@color/accent_indoor</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- 次色调 -->
        <item name="colorSecondary">@color/accent_favorite</item>
        <item name="colorSecondaryVariant">@color/accent_favorite</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
